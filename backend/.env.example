# Copy this file to .env (or set these as real environment variables) and
# fill in the values from your CognoDB Cloud instance.
# NEVER commit the real .env file.

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-generated-password>

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173

# Port the Spring Boot server listens on
PORT=8080

# Automatically load demo seed data on startup if the graph is empty
AUTO_SEED=true
